        793,
        765
      ]
    },
    {
      "id": 76,
      "page": 2,
      "category": "text",
      "text": "A. Porque com ele, ela queria ter outros'amigos.",
      "bbox": [
        126,
        778,
        521,
        796
      ]
    },
    {
      "id": 77,
      "page": 2,
      "category": "text",
      "text": "B. Porque ela não era feliz.",
      "bbox": [
