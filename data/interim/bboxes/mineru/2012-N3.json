{"id":107,"page":3,"category":"text","text":"O Robo","bbox":[141,559,200,572]},
{"id":108,"page":3,"category":"text","text":"(Toquinho)","bbox":[141,575,227,590]},
{"id":109,"page":3,"category":"text","text":"Quanta coisa ele conhece,","bbox":[141,591,339,605]},
{"id":110,"page":3,"category":"text","text":"Sabe a tudo responder.","bbox":[141,607,317,620]},
{"id":111,"page":3,"category":"text","text":"E o que tanto o entriste","bbox":[141,624,336,637]},
{"id":112,"page":3,"category":"text","text":"E ser humano ele nao ser.","bbox":[141,639,336,651]},
{"id":113,"page":3,"category":"text","text":"Com susas veias de metal","bbox":[141,655,327,668]},
{"id":114,"page":3,"category":"text","text":"Raciocina sabe andar.","bbox":[141,671,319,684]},
{"id":115,"page":3,"category":"text","text":"Mas o que Ihe faz tao mal","bbox":[141,687,336,701]},
{"id":116,"page":3,"category":"text","text":"E não sorrir e nenchorar.","bbox":[141,703,338,716]},
{"id":117,"page":3,"category":"text","text":"Sou robô e a vida é dura","bbox":[141,719,325,731]},
{"id":118,"page":3,"category":"text","text":"Quando se é feito de lata.","bbox":[141,735,335,748]},
{"id":119,"page":3,"category":"text","text":"Sou sem jogo de cintura","bbox":[141,751,324,764]},
{"id":120,"page":3,"category":"text","text":"E a minha voz é muito chata.","bbox":[141,767,357,780]},
{"id":121,"page":3,"category":"text","text":"Vou ter sempre algoq difeito,","bbox":[141,783,372,796]},
{"id":122,"page":3,"category":"text","text":"Ja perdia esperança.","bbox":[141,799,300,812]},
{"id":123,"page":3,"category":"text","text":"Pelo homem eu fui feito","bbox":[141,815,324,827]},
{"id":124,"page":3,"category":"text","text":"A sua imagem semelhanca.","bbox":[141,830,359,844]},
{"id":125,"page":3,"category":"text","text":"Nunca tem nenhuma duvida,","bbox":[141,847,359,860]},
{"id":126,"page":3,"category":"text","text":"Incansável e seguro.","bbox":[141,863,294,876]},
{"id":127,"page":3,"category":"text","text":"Por todo isso ele éconsiderado","bbox":[141,879,377,891]},
{"id":128,"page":3,"category":"text","text":"O homem do futuro.","bbox":[141,894,296,907]}
